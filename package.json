{
  "name": "powershell-watchdog",
  "displayName": "PowerShell Memory Watchdog",
  "description": "Monitor memory of pwsh processes owned by each local VS Code window on Windows.",
  "version": "0.2.0",
  "publisher": "FrenchExDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrenchExDev2/PoSh.WatchDog.PoSh.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.114.0",
    "node": ">=22"
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "PowerShell",
    "memory",
    "watchdog"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --out dist/",
    "test:integration": "node test/run-integration.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "powershellWatchdog.enable",
        "title": "PowerShell Watchdog: Enable"
      },
      {
        "command": "powershellWatchdog.disable",
        "title": "PowerShell Watchdog: Disable"
      },
      {
        "command": "powershellWatchdog.suspend",
        "title": "PowerShell Watchdog: Suspend…"
      },
      {
        "command": "powershellWatchdog.resume",
        "title": "PowerShell Watchdog: Resume"
      },
      {
        "command": "powershellWatchdog.changeMode",
        "title": "PowerShell Watchdog: Change Mode…"
      },
      {
        "command": "powershellWatchdog.restart",
        "title": "PowerShell Watchdog: Restart Editor Services Session…"
      },
      {
        "command": "powershellWatchdog.diagnostics",
        "title": "PowerShell Watchdog: Show Diagnostics"
      },
      {
        "command": "powershellWatchdog.menu",
        "title": "PowerShell Watchdog: Show Actions"
      }
    ],
    "configuration": {
      "title": "PowerShell Watchdog",
      "properties": {
        "frenchexdev.powershellWatchdog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Monitor pwsh instances launched by this VS Code window, its terminals and their child processes.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.mode": {
          "type": "string",
          "enum": [
            "automatic",
            "notifyOnly"
          ],
          "default": "automatic",
          "description": "Editor Services may restart automatically; ordinary terminal and child pwsh instances generate alerts only. An editor restart can interrupt running commands.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.sampleIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 15,
          "description": "Delay between completed collections, in seconds.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.warningPrivateGiB": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4,
          "description": "Private committed memory warning threshold, in GiB.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.restartPrivateGiB": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8,
          "description": "Private committed memory restart threshold, in GiB.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.consecutiveSamples": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Consecutive valid samples at or above the restart threshold.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.collectTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3,
          "description": "Maximum time for session resolution and collection.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.restartTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 45,
          "description": "Deadline for a measured replacement session, including command execution.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.cooldownSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 120,
          "description": "Stabilization delay following a measured replacement session.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.maxAutomaticRestartsPerHour": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum automatic restart requests in a rolling hour, retained across reloads.",
          "scope": "machine"
        },
        "frenchexdev.powershellWatchdog.deferWhileDebugging": {
          "type": "boolean",
          "default": true,
          "description": "Defer automatic restart while any PowerShell debug session is active.",
          "scope": "machine"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  }
}
